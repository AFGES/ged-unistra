{
  "name": "webdav-cas-proxy",
  "version": "0.1.0",
  "description": "Proxy WebDAV avec authentification CAS pour Unistra",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "dev:watch": "nodemon --exec \"ts-node\" src/server.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docker:build": "docker build -t webdav-cas-proxy:0.1.0 .",
    "docker:build-no-cache": "docker build --no-cache -t webdav-cas-proxy:0.1.0 .",
    "docker:run": "docker run -d -p 3000:3000 --name webdav-cas-proxy webdav-cas-proxy:0.1.0",
    "docker:stop": "docker stop webdav-cas-proxy && docker rm webdav-cas-proxy",
    "docker:compose": "docker-compose up -d",
    "docker:compose-down": "docker-compose down",
    "docker:logs": "docker logs webdav-cas-proxy -f"
  },
  "dependencies": {
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "webdav",
    "proxy",
    "cas",
    "authentication",
    "unistra"
  ],
  "author": "",
  "license": "MIT"
}