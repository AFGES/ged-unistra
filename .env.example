# Configuration d'environnement pour WebDAV CAS Proxy
# Copier ce fichier en .env pour la configuration locale

# Configuration du serveur
NODE_ENV=production
PORT=3000

# URLs CAS et WebDAV (optionnel - hardcodé dans le code par défaut)
# CAS_LOGIN_URL=https://cas.unistra.fr/cas/login?service=https%3A%2F%2Fged.unistra.fr%2Fnuxeo%2Flogin%2Fcas
# WEBDAV_BASE_URL=https://ged.unistra.fr/nuxeo/

# Mode debug (true/false)
DEBUG_MODE=false

# Configuration du cache
CACHE_TTL=3600
AUTH_CACHE_TTL=3000

# Configuration Docker (utilisé par docker-compose)
DOCKER_IMAGE=webdav-cas-proxy:0.1.0
DOCKER_CONTAINER_NAME=webdav-cas-proxy