# Configuration d'environnement pour WebDAV CAS Proxy
# Copier ce fichier en .env pour la configuration locale

# Configuration du serveur
NODE_ENV=production
PORT=3000

# URLs CAS et WebDAV
# Valeurs par défaut utilisées si non spécifiées :
# - CAS_LOGIN_URL: https://cas.unistra.fr/cas/login?service=https%3A%2F%2Fged.unistra.fr%2Fnuxeo%2Fnxstartup.faces
# - WEBDAV_BASE_URL: https://ged.unistra.fr/nuxeo/site/dav/
CAS_LOGIN_URL=https://cas.unistra.fr/cas/login?service=https%3A%2F%2Fged.unistra.fr%2Fnuxeo%2Fnxstartup.faces
WEBDAV_BASE_URL=https://ged.unistra.fr/nuxeo/site/dav/

# Mode debug (true/false) - automatiquement true si NODE_ENV=development
DEBUG_MODE=false

# Configuration du cache
CACHE_TTL=3600
AUTH_CACHE_TTL=3000

# Configuration Docker (utilisé par docker-compose)
DOCKER_IMAGE=webdav-cas-proxy:0.1.0
DOCKER_CONTAINER_NAME=webdav-cas-proxy